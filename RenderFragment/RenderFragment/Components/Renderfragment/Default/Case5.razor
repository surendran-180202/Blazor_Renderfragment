

<div class="page-box view-box">

    <div class="headline">Laptops Management: </div>

    <table class="table header--darksalmon">
        <thead>
            @HeaderContent
        </thead>
        <tbody>
            @BodyContent
        </tbody>
    </table>

    @FooterContent
</div>

@code {
    [Parameter]
    public RenderFragment HeaderContent { get; set; }

    [Parameter]
    public RenderFragment BodyContent { get; set; }

    [Parameter]
    public RenderFragment FooterContent { get; set; }
}
