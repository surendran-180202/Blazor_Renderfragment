
<section class="page-box">

    <table class="table-default">
        <thead>
            <tr>
                <td>First Name</td>
                <td>Middle Name</td>
                <td>Last Name</td>
                <td>User Id</td>
                <td>Password</td>
            </tr>
        </thead>
        <tbody>

            @ChildContent

        </tbody>
    </table>

</section>

@code
{
    RenderFragment ChildContent => builder =>
    {
        int nIndex = 0;

        for (int i = 0; i < 5; i++)
        {
            builder.OpenElement(nIndex++, "tr");

            builder.OpenElement(nIndex++, "td");
            builder.AddContent(nIndex++, "Test FirstName");
            builder.CloseElement();

            builder.OpenElement(nIndex++, "td");
            builder.AddContent(nIndex++, "Test MiddleName");
            builder.CloseElement();

            builder.OpenElement(nIndex++, "td");
            builder.AddContent(nIndex++, "Test LastName");
            builder.CloseElement();

            builder.OpenElement(nIndex++, "td");
            builder.AddContent(nIndex++, "Test UserId");
            builder.CloseElement();

            builder.OpenElement(nIndex++, "td");
            builder.AddContent(nIndex++, "Test Password");
            builder.CloseElement();

            builder.CloseElement();

        };
    };
}
