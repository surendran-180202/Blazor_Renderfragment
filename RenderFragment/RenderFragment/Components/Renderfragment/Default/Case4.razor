


<section class="page-box">
    
    <div class="headline">Bills Management: </div>

    <table class="table header--antiquewhite">
        <thead>
        <tr>
            <td>Bill ID</td>
            <td>Date</td>
            <td>Amount</td>
            <td>Attachment</td>
            <td>Remarks</td>
        </tr>
        </thead>
        <tbody>

        @ChildContent

        </tbody>
    </table>

</section>

@code
{
    RenderFragment ChildContent => builder =>
    {
        int nIndex = 0;

        for (int i = 0; i < 5; i++)
        {
            builder.OpenElement(nIndex++, "tr");

            builder.OpenElement(nIndex++, "td");
            builder.AddContent(nIndex++, "Test Bill ID");
            builder.CloseElement();

            builder.OpenElement(nIndex++, "td");
            builder.AddContent(nIndex++, "Test Date");
            builder.CloseElement();

            builder.OpenElement(nIndex++, "td");
            builder.AddContent(nIndex++, "Test Amount");
            builder.CloseElement();

            builder.OpenElement(nIndex++, "td");
            builder.AddContent(nIndex++, "Test Attachment");
            builder.CloseElement();

            builder.OpenElement(nIndex++, "td");
            builder.AddContent(nIndex++, "Test Remarks");
            builder.CloseElement();

            builder.CloseElement();

        };
    };
}
