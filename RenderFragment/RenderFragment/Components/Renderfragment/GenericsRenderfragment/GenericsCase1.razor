@typeparam Type

<section class="page-box view-box margin-box">
    
    <div class="headline">Employee Management: </div>

    <table class="table header--lavender">
        <thead>
        <tr>
            <td>First Name</td>
            <td>Middle Name</td>
            <td>Last Name</td>
            <td>User Id</td>
            <td>Password</td>
        </tr>
        </thead>
        <tbody>

        @foreach (var item in Data)
        {
            <tr>
                @DataContent(item)
            </tr>
        }

        </tbody>
    </table>

</section>

@code {
    [Parameter]
    public List<Type> Data { get; set; }

    [Parameter]
    public RenderFragment<Type> DataContent { get; set; }
}