@typeparam Type

<section class="page-box view-box">

    <h3>Generic Child Component</h3>

    <ul>
        @foreach (var item in Data)
        {
            <li>@DataContent(item)</li>
        }
    </ul>

</section>

@code {
    [Parameter]
    public List<Type> Data { get; set; }

    [Parameter]
    public RenderFragment<Type> DataContent { get; set; }
}