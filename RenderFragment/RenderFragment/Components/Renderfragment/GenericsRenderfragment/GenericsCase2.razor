

<div class="page-box view-box">
    
    <div class="headline">Greetings: </div>

    <div class="page-box view-box">

        @Greetings("All")

    </div>

    <div class="page-box view-box">

        @Greetings("surendran")

    </div>

    <div class="page-box view-box">

        @Greetings2(180202)

    </div>
</div>


@code {

    private RenderFragment<string> Greetings => (strEmployeeName) => builder =>
    {
        builder.AddContent(0, $"Dear {strEmployeeName}, Welcome to TechForum");
    };

    private RenderFragment<int> Greetings2 => (nEmployeeId) => builder =>
    {
        builder.AddContent(0, $"Dear {nEmployeeId}, Welcome to TechForum");
    };
}


