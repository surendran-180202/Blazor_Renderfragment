@page "/generics"

<section class="center--text">
    <h1><code class="code--red">RenderFragment Generics</code></h1>
</section>


<section class="fragment-types">

    <GenericsCase1 TModal="Employee" Data="@liEmployees">
        <DataContent>
            <td> @context.FirstName </td>
            <td> @context.MiddleName </td>
            <td> @context.LastName </td>
            <td> @context.UserId </td>
            <td> @context.Password </td>
        </DataContent>
    </GenericsCase1>
    

    <GenericsCase2/>

</section>


