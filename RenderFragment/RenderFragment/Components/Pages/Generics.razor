@page "/generics"

<section class="center--text">
    <h1><code class="code--red">RenderFragment Generics</code></h1>
</section>

<div class="headline">RenderFragment Case 1</div>

<GenericsCase1 TItem="Employee" Items="@liEmployees">
    <ItemContent>
        <p>
            FirstName: @context.FirstName ,
            MiddleName: @context.MiddleName ,
            LastName: @context.LastName ,
            UserId: @context.UserId ,
            Password: @context.Password
        </p>
    </ItemContent>
</GenericsCase1>


<div class="headline">RenderFragment Case 2</div>

<GenericsCase2 />


@code {
    private List<Employee> liEmployees = new()
    {
        new Employee
        {
            FirstName = "Surendran",
            MiddleName = "-",
            LastName = "B",
            UserId = "surendran@123",
            Password = "\t098123"
        },

        new Employee
        {
            FirstName = "Sivabalan",
            MiddleName = "-",
            LastName = "P",
            UserId = "sivabalan@123",
            Password = "0981234"
        },

    };

    public class Employee
    {
        public string FirstName { get; set; } = string.Empty;
        public string MiddleName { get; set; } = string.Empty;
        public string LastName { get; set; } = string.Empty;
        public string UserId { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
    }
}